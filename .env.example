# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase credentials and maintenance configuration
SUPABASE_SERVICE_ROLE_KEY=
# Legacy Supabase HS256 JWT signing secret. Server-only; used to mint a short-lived
# authenticated PostgREST claim only after validating a Physio Fund Circle app session.
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=

# App-owned email verification and recovery rate-limit HMAC secret
AUTH_EMAIL_OTP_SECRET=

# App-owned sessions, TOTP encryption, and rate-limit bucket secrets (server-only)
AUTH_SESSION_SECRET=
AUTH_MFA_ENCRYPTION_KEY=

# Brevo REST API credentials for application emails
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Physio Fund Circle

# Optional legacy SMTP credentials. Application auth/email uses Brevo REST;
# these are not used as REST credentials or by any active Supabase Auth flow.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Required only by the local development seed script
PhyaioCycle_SEED_PASSWORD=
