NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local administrative scripts only. Never add this value to NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
# Used only by pnpm auth:configure-email. Keep these values out of source control.
SUPABASE_PROJECT_REF=

Phyaio Cycle_AUTH_SENDER_EMAIL=
# Required only by the local development seed script.
Phyaio Cycle_SEED_PASSWORD=
# Local PostgreSQL URL used by the destructive db:reset command; use localhost only.
SUPABASE_DB_URL=
